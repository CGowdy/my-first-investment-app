{
  "name": "my-first-investment-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "db:seed:integration": "node scripts/seed-mongo-integration.mjs",
    "db:cleanup:integration": "node scripts/cleanup-mongo-integration.mjs",
    "test:e2e:integration": "node scripts/run-mongo-integration.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "playwright:install": "playwright install chromium",
    "playwright:ui": "playwright test --ui --project=chromium"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "dotenv": "^16.6.1",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-modal": "^3.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
