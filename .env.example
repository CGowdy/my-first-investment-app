# Selects the client returned by /api/client. Use mock for local UI work.
ENVIRONMENT=mock

# Required only when ENVIRONMENT resolves to the Mongo-backed client.
# Keep credentials server-side. Never prefix these variables with NEXT_PUBLIC_.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_CLUSTER_HOST=
MONGODB_DATABASE=

# At least 32 random characters. Used to sign HttpOnly authentication sessions.
AUTH_SECRET=

# Alternatively, MONGODB_URI may replace the username, password, and host variables.
# MONGODB_URI=

# Optional: target an already-running server instead of Playwright's managed local server.
PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3000
